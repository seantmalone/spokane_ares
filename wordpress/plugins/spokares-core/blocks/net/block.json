{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "spokares/net",
	"title": "Net facts",
	"category": "spokares",
	"icon": "microphone",
	"description": "The weekly net: its settings, the Net Control Schedule and Winlink assignments. Edit them on the Net Control Schedule and Net Settings screens.",
	"textdomain": "spokares-core",
	"attributes": {
		"view": {
			"type": "string",
			"default": "rota",
			"enum": [
				"bar",
				"settings",
				"rota",
				"winlink",
				"from-home",
				"other-nets"
			],
			"label": "What to show"
		},
		"weeks": {
			"type": "integer",
			"default": 5,
			"label": "Weeks shown"
		},
		"limit": {
			"type": "integer",
			"default": 8,
			"label": "Rows (Winlink)"
		}
	},
	"supports": {
		"autoRegister": true,
		"html": false,
		"reusable": false,
		"className": true
	},
	"usesContext": [
		"postId"
	],
	"render": "file:./render.php"
}
