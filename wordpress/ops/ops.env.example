# Copy to wordpress/ops/ops.env (never commit ops.env) and fill in.
# Used by deploy.sh, check-live.sh and backup-pull.sh on the admin's machine.
#
# The SSH aliases live in ~/.ssh/config, e.g.
#   Host spokares-live
#     HostName <the Enhance SSH host>
#     User <the website's SSH user>
#     Port 22
#     IdentityFile ~/.ssh/spokares_deploy
#     IdentitiesOnly yes

SPOKARES_LIVE_SSH=spokares-live
SPOKARES_LIVE_URL=https://spokares.org

# A per-release Enhance staging site (PLAN §5.7: clone, deploy, test, delete).
SPOKARES_STAGING_SSH=spokares-staging
SPOKARES_STAGING_URL=https://staging.spokares.org

# WordPress's folder, relative to the SSH user's home.
SPOKARES_WP_PATH=public_html

# backup-pull.sh: where the monthly copies go. It must be on an encrypted
# volume (FileVault or an encrypted external disk); backup-pull.sh warns if not.
SPOKARES_BACKUP_DIR="$HOME/spokares-backups"
