<?xml version="1.0"?>
<ruleset name="spokares">
	<description>PHPCS for spokares.org: WordPress-Extra (PLAN.md §5.7; research security-hosting.md §9.1). ops/ci.sh adds PHPCompatibilityWP (testVersion 8.3-) when that standard is installed.</description>

	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<!-- Generated by tools/redirects/gen-redirect-map.mjs: one long data array. -->
	<exclude-pattern>*/mu-plugins/spokares-hardening/redirect-map.php</exclude-pattern>

	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress-Extra">
		<!-- Shells out to `php -l`; ci.sh lints every file on PHP 8.3 and 8.4 itself. -->
		<exclude name="Generic.PHP.Syntax"/>
	</rule>

	<!-- Every settings handler checks its capability and nonce in
	     spokares_verify_form() (capability, then check_admin_referer()). -->
	<rule ref="WordPress.Security.NonceVerification">
		<properties>
			<property name="customNonceVerificationFunctions" type="array">
				<element value="spokares_verify_form"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="spokares"/>
				<element value="spokares-core"/>
				<element value="spokares-hardening"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="spokares"/>
			</property>
		</properties>
	</rule>

	<!-- PLAN.md §6.2: the plugin's own capabilities and the CPT capability types. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="spokares_edit_rota"/>
				<element value="spokares_edit_net_details"/>
				<element value="edit_spk_events"/>
				<element value="edit_others_spk_events"/>
				<element value="edit_published_spk_events"/>
				<element value="publish_spk_events"/>
				<element value="delete_spk_events"/>
				<element value="edit_spk_documents"/>
				<element value="edit_others_spk_documents"/>
				<element value="edit_published_spk_documents"/>
				<element value="publish_spk_documents"/>
				<element value="delete_spk_documents"/>
			</property>
		</properties>
	</rule>
</ruleset>
